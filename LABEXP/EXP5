        "import random\n",
        "\n",
        "# Advertisements (Bandits)\n",
        "ads = [\"Ad A\", \"Ad B\", \"Ad C\", \"Ad D\"]\n",
        "\n",
        "# True click probabilities (unknown to the agent)\n",
        "true_probabilities = [0.2, 0.5, 0.7, 0.4]\n",
        "\n",
        "# Estimated values for each ad\n",
        "Q = [0.0] * len(ads)\n",
        "\n",
        "# Number of times each ad is selected\n",
        "N = [0] * len(ads)\n",
        "\n",
        "# Parameters\n",
        "epsilon = 0.1        # Exploration rate\n",
        "iterations = 1000\n",
        "\n",
        "total_reward = 0\n",
        "\n",
        "for i in range(iterations):\n",
        "\n",
        "    # ε-Greedy Action Selection\n",
        "    if random.random() < epsilon:\n",
        "        action = random.randint(0, len(ads) - 1)   # Explore\n",
        "    else:\n",
        "        action = Q.index(max(Q))                   # Exploit\n",
        "\n",
        "    # Simulate User Click\n",
        "    if random.random() < true_probabilities[action]:\n",
        "        reward = 1\n",
        "    else:\n",
        "        reward = 0\n",
        "\n",
        "    total_reward += reward\n",
        "\n",
        "    # Update Counts\n",
        "    N[action] += 1\n",
        "\n",
        "    # Update Estimated Reward\n",
        "    Q[action] = Q[action] + (reward - Q[action]) / N[action]\n",
        "\n",
        "# Results\n",
        "print(\"Advertisement Statistics\")\n",
        "print(\"----------------------------\")\n",
        "\n",
        "for i in range(len(ads)):\n",
        "    print(f\"{ads[i]}\")\n",
        "    print(f\"Times Selected : {N[i]}\")\n",
        "    print(f\"Estimated CTR  : {Q[i]:.3f}\")\n",
        "    print()\n",
        "\n",
        "best_ad = ads[Q.index(max(Q))]\n",
        "\n",
        "print(\"Best Advertisement:\", best_ad)\n",
        "print(\"Total Clicks:\", total_reward)"
      ]
