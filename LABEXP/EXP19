        "import random\n",
        "\n",
        "# Two warehouse robots\n",
        "robots = [\"Robot-1\", \"Robot-2\"]\n",
        "tasks = [\"Pick\", \"Store\", \"Deliver\", \"Charge\"]\n",
        "\n",
        "# Simulate task allocation\n",
        "for episode in range(5):\n",
        "    print(f\"\\nEpisode {episode+1}\")\n",
        "    total_reward = 0\n",
        "\n",
        "    for robot in robots:\n",
        "        task = random.choice(tasks)\n",
        "        success = random.choice([True, False])\n",
        "\n",
        "        if success:\n",
        "            reward = 10\n",
        "            print(robot, \"completed\", task)\n",
        "        else:\n",
        "            reward = -5\n",
        "            print(robot, \"failed\", task)\n",
        "\n",
        "        total_reward += reward\n",
        "\n",
        "    print(\"Total Reward:\", total_reward)\n",
        "\n",
        "print(\"\\nMARL Training Completed\")"
      ]
