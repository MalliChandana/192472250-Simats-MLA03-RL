      "source": [
        "import random\n",
        "\n",
        "# States, Observations, Actions\n",
        "states = [\"Safe\", \"Victim\", \"Obstacle\"]\n",
        "observations = [\"Noise\", \"Heat\", \"Clear\"]\n",
        "actions = [\"Move\", \"Search\", \"Rescue\"]\n",
        "\n",
        "belief = {\"Safe\": 0.5, \"Victim\": 0.3, \"Obstacle\": 0.2}\n",
        "\n",
        "# Simulate POMDP\n",
        "for step in range(5):\n",
        "    obs = random.choice(observations)\n",
        "    action = random.choice(actions)\n",
        "    state = random.choices(states, weights=belief.values())[0]\n",
        "\n",
        "    print(f\"Step {step+1}\")\n",
        "    print(\"Observation:\", obs)\n",
        "    print(\"Action:\", action)\n",
        "    print(\"Estimated State:\", state)\n",
        "\n",
        "print(\"\\nPOMDP Decision Process Completed\")"
      ]
