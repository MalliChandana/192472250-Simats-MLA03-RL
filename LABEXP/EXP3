      "source": [
        "# Markov Decision Process (MDP) for an Autonomous Warehouse Robot\n",
        "\n",
        "# States\n",
        "states = [\"Start\", \"PickItem\", \"Move\", \"Deliver\", \"Goal\"]\n",
        "\n",
        "# Actions available in each state\n",
        "actions = {\n",
        "    \"Start\": [\"GoToShelf\"],\n",
        "    \"PickItem\": [\"Pick\"],\n",
        "    \"Move\": [\"MoveToDelivery\"],\n",
        "    \"Deliver\": [\"DeliverPackage\"],\n",
        "    \"Goal\": []\n",
        "}\n",
        "\n",
        "# Transition Probabilities\n",
        "transitions = {\n",
        "    (\"Start\", \"GoToShelf\"): [(\"PickItem\", 1.0)],\n",
        "    (\"PickItem\", \"Pick\"): [(\"Move\", 0.9), (\"Start\", 0.1)],\n",
        "    (\"Move\", \"MoveToDelivery\"): [(\"Deliver\", 0.8), (\"Move\", 0.2)],\n",
        "    (\"Deliver\", \"DeliverPackage\"): [(\"Goal\", 0.95), (\"Move\", 0.05)]\n",
        "}\n",
        "\n",
        "# Rewards\n",
        "rewards = {\n",
        "    \"Start\": 0,\n",
        "    \"PickItem\": 10,\n",
        "    \"Move\": 20,\n",
        "    \"Deliver\": 50,\n",
        "    \"Goal\": 100\n",
        "}\n",
        "\n",
        "# Discount Factor\n",
        "gamma = 0.9\n",
        "\n",
        "# Initialize Value Function\n",
        "V = {state: 0 for state in states}\n",
        "\n",
        "# Value Iteration\n",
        "threshold = 0.001\n",
        "\n",
        "while True:\n",
        "    delta = 0\n",
        "\n",
        "    for state in states:\n",
        "\n",
        "        if state == \"Goal\":\n",
        "            continue\n",
        "\n",
        "        max_value = float('-inf')\n",
        "\n",
        "        for action in actions[state]:\n",
        "\n",
        "            value = 0\n",
        "\n",
        "            for next_state, probability in transitions[(state, action)]:\n",
        "                reward = rewards[next_state]\n",
        "                value += probability * (reward + gamma * V[next_state])\n",
        "\n",
        "            max_value = max(max_value, value)\n",
        "\n",
        "        delta = max(delta, abs(V[state] - max_value))\n",
        "        V[state] = max_value\n",
        "\n",
        "    if delta < threshold:\n",
        "        break\n",
        "\n",
        "# Display State Values\n",
        "print(\"Optimal State Values\")\n",
        "print(\"-----------------------\")\n",
        "\n",
        "for state in states:\n",
        "    print(f\"{state:10} : {V[state]:.2f}\")\n",
        "\n",
        "# Find Optimal Policy\n",
        "policy = {}\n",
        "\n",
        "for state in states:\n",
        "\n",
        "    if state == \"Goal\":\n",
        "        policy[state] = \"-\"\n",
        "        continue\n",
        "\n",
        "    best_action = None\n",
        "    best_value = float('-inf')\n",
        "\n",
        "    for action in actions[state]:\n",
        "\n",
        "        value = 0\n",
        "\n",
        "        for next_state, probability in transitions[(state, action)]:\n",
        "            reward = rewards[next_state]\n",
        "            value += probability * (reward + gamma * V[next_state])\n",
        "\n",
        "        if value > best_value:\n",
        "            best_value = value\n",
        "            best_action = action\n",
        "\n",
        "    policy[state] = best_action\n",
        "\n",
        "print(\"\\nOptimal Policy\")\n",
        "print(\"-----------------------\")\n",
        "\n",
        "for state in states:\n",
        "    print(f\"{state:10} --> {policy[state]}\")"
      ]
