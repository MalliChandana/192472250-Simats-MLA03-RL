        "import numpy as np\n",
        "import random\n",
        "\n",
        "# Grid World (5x5)\n",
        "grid_size = 5\n",
        "\n",
        "# Rewards\n",
        "rewards = np.full((grid_size, grid_size), -1)\n",
        "\n",
        "# Obstacles\n",
        "obstacles = [(1, 2), (2, 2), (3, 1)]\n",
        "for obs in obstacles:\n",
        "    rewards[obs] = -100\n",
        "\n",
        "# Goal\n",
        "goal = (4, 4)\n",
        "rewards[goal] = 100\n",
        "\n",
        "# Actions\n",
        "actions = [\"up\", \"down\", \"left\", \"right\"]\n",
        "\n",
        "# Q-table\n",
        "Q = np.zeros((grid_size, grid_size, len(actions)))\n",
        "\n",
        "# Parameters\n",
        "alpha = 0.8      # Learning rate\n",
        "gamma = 0.9      # Discount factor\n",
        "epsilon = 0.2    # Exploration rate\n",
        "episodes = 1000\n",
        "\n",
        "# Choose action\n",
        "def choose_action(state):\n",
        "    if random.uniform(0, 1) < epsilon:\n",
        "        return random.randint(0, 3)\n",
        "    return np.argmax(Q[state[0], state[1]])\n",
        "\n",
        "# Get next state\n",
        "def move(state, action):\n",
        "    x, y = state\n",
        "\n",
        "    if action == 0 and x > 0:\n",
        "        x -= 1\n",
        "    elif action == 1 and x < grid_size - 1:\n",
        "        x += 1\n",
        "    elif action == 2 and y > 0:\n",
        "        y -= 1\n",
        "    elif action == 3 and y < grid_size - 1:\n",
        "        y += 1\n",
        "\n",
        "    return (x, y)\n",
        "\n",
        "# Training\n",
        "for episode in range(episodes):\n",
        "\n",
        "    state = (0, 0)\n",
        "\n",
        "    while state != goal:\n",
        "\n",
        "        action = choose_action(state)\n",
        "        next_state = move(state, action)\n",
        "\n",
        "        reward = rewards[next_state]\n",
        "\n",
        "        old_value = Q[state[0], state[1], action]\n",
        "        next_max = np.max(Q[next_state[0], next_state[1]])\n",
        "\n",
        "        # Q-learning update\n",
        "        Q[state[0], state[1], action] = old_value + alpha * (\n",
        "            reward + gamma * next_max - old_value\n",
        "        )\n",
        "\n",
        "        if reward == -100:\n",
        "            break\n",
        "\n",
        "        state = next_state\n",
        "\n",
        "# Best Path\n",
        "print(\"Optimal Path:\\n\")\n",
        "\n",
        "state = (0, 0)\n",
        "path = [state]\n",
        "\n",
        "while state != goal:\n",
        "\n",
        "    action = np.argmax(Q[state[0], state[1]])\n",
        "    state = move(state, action)\n",
        "\n",
        "    if state in path:\n",
        "        break\n",
        "\n",
        "    path.append(state)\n",
        "\n",
        "print(path)\n",
        "\n",
        "# Display Policy\n",
        "symbols = [\"↑\", \"↓\", \"←\", \"→\"]\n",
        "\n",
        "print(\"\\nLearned Policy:\\n\")\n",
        "\n",
        "for i in range(grid_size):\n",
        "    for j in range(grid_size):\n",
        "\n",
        "        if (i, j) == goal:\n",
        "            print(\" G \", end=\" \")\n",
        "\n",
        "        elif (i, j) in obstacles:\n",
        "            print(\" X \", end=\" \")\n",
        "\n",
        "        else:\n",
        "            best = np.argmax(Q[i, j])\n",
        "            print(symbols[best], end=\"  \")\n",
        "\n",
        "    print()"
