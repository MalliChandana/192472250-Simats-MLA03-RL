            "\n",
            "Optimal State Values\n",
            "---------------------\n",
            "Start      : 64.00\n",
            "Attack     : 60.00\n",
            "Defend     : 60.00\n",
            "Win        : 0.00\n",
            "Lose       : 0.00\n",
            "\n",
            "Optimal Policy\n",
            "---------------------\n",
            "Start      --> Attack\n",
            "Attack     --> Finish\n",
            "Defend     --> Wait\n",
            "Win        --> -\n",
            "Lose       --> -\n"
          ]
