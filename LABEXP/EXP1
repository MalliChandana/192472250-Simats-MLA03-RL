      ],
      "source": [
        "# Simplified Chess Game using Markov Decision Process (MDP)\n",
        "\n",
        "# Define the states\n",
        "states = [\"Start\", \"Attack\", \"Defend\", \"Win\", \"Lose\"]\n",
        "\n",
        "# Terminal states\n",
        "terminal_states = [\"Win\", \"Lose\"]\n",
        "\n",
        "# Possible actions in each state\n",
        "actions = {\n",
        "    \"Start\": [\"Attack\", \"Defend\"],\n",
        "    \"Attack\": [\"Finish\", \"Retreat\"],\n",
        "    \"Defend\": [\"Counter\", \"Wait\"],\n",
        "    \"Win\": [],\n",
        "    \"Lose\": []\n",
        "}\n",
        "\n",
        "# Transition probabilities\n",
        "transition = {\n",
        "    (\"Start\", \"Attack\"): [(\"Attack\", 1.0)],\n",
        "    (\"Start\", \"Defend\"): [(\"Defend\", 1.0)],\n",
        "\n",
        "    (\"Attack\", \"Finish\"): [(\"Win\", 0.8), (\"Lose\", 0.2)],\n",
        "    (\"Attack\", \"Retreat\"): [(\"Defend\", 1.0)],\n",
        "\n",
        "    (\"Defend\", \"Counter\"): [(\"Attack\", 0.7), (\"Lose\", 0.3)],\n",
        "    (\"Defend\", \"Wait\"): [(\"Defend\", 0.8), (\"Attack\", 0.2)]\n",
        "}\n",
        "\n",
        "# Rewards\n",
        "rewards = {\n",
        "    \"Win\": 100,\n",
        "    \"Lose\": -100,\n",
        "    \"Attack\": 10,\n",
        "    \"Defend\": 5,\n",
        "    \"Start\": 0\n",
        "}\n",
        "\n",
        "gamma = 0.9          # Discount factor\n",
        "theta = 0.001        # Convergence threshold\n",
        "\n",
        "# Initialize state values\n",
        "V = {state: 0 for state in states}\n",
        "\n",
        "# Value Iteration Algorithm\n",
        "while True:\n",
        "    delta = 0\n",
        "\n",
        "    for state in states:\n",
        "\n",
        "        if state in terminal_states:\n",
        "            continue\n",
        "\n",
        "        max_value = float('-inf')\n",
        "\n",
        "        for action in actions[state]:\n",
        "\n",
        "            value = 0\n",
        "\n",
        "            for next_state, prob in transition[(state, action)]:\n",
        "                reward = rewards[next_state]\n",
        "                value += prob * (reward + gamma * V[next_state])\n",
        "\n",
        "            if value > max_value:\n",
        "                max_value = value\n",
        "\n",
        "        delta = max(delta, abs(V[state] - max_value))\n",
        "        V[state] = max_value\n",
        "\n",
        "    if delta < theta:\n",
        "        break\n",
        "\n",
        "# Display State Values\n",
        "print(\"\\nOptimal State Values\")\n",
        "print(\"---------------------\")\n",
        "for state in states:\n",
        "    print(f\"{state:10} : {V[state]:.2f}\")\n",
        "\n",
        "# Extract Optimal Policy\n",
        "policy = {}\n",
        "\n",
        "for state in states:\n",
        "\n",
        "    if state in terminal_states:\n",
        "        policy[state] = \"-\"\n",
        "        continue\n",
        "\n",
        "    best_action = None\n",
        "    best_value = float('-inf')\n",
        "\n",
        "    for action in actions[state]:\n",
        "\n",
        "        value = 0\n",
        "\n",
        "        for next_state, prob in transition[(state, action)]:\n",
        "            reward = rewards[next_state]\n",
        "            value += prob * (reward + gamma * V[next_state])\n",
        "\n",
        "        if value > best_value:\n",
        "            best_value = value\n",
        "            best_action = action\n",
        "\n",
        "    policy[state] = best_action\n",
        "\n",
        "print(\"\\nOptimal Policy\")\n",
        "print(\"---------------------\")\n",
        "for state in states:\n",
        "    print(f\"{state:10} --> {policy[state]}\")"
      ]
