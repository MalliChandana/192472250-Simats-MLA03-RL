        "# Bellman Equation for Autonomous Delivery Robot\n",
        "\n",
        "# States\n",
        "states = [\"A\", \"B\", \"C\", \"D\", \"Goal\"]\n",
        "\n",
        "# Actions\n",
        "actions = {\n",
        "    \"A\": [\"toB\", \"toC\"],\n",
        "    \"B\": [\"toD\"],\n",
        "    \"C\": [\"toD\"],\n",
        "    \"D\": [\"toGoal\"],\n",
        "    \"Goal\": []\n",
        "}\n",
        "\n",
        "# Transition Probabilities\n",
        "transitions = {\n",
        "    (\"A\", \"toB\"): [(\"B\", 1.0)],\n",
        "    (\"A\", \"toC\"): [(\"C\", 1.0)],\n",
        "    (\"B\", \"toD\"): [(\"D\", 1.0)],\n",
        "    (\"C\", \"toD\"): [(\"D\", 1.0)],\n",
        "    (\"D\", \"toGoal\"): [(\"Goal\", 1.0)]\n",
        "}\n",
        "\n",
        "# Travel Costs\n",
        "cost = {\n",
        "    (\"A\", \"B\"): 3,\n",
        "    (\"A\", \"C\"): 5,\n",
        "    (\"B\", \"D\"): 2,\n",
        "    (\"C\", \"D\"): 4,\n",
        "    (\"D\", \"Goal\"): 1\n",
        "}\n",
        "\n",
        "gamma = 0.9\n",
        "\n",
        "# Initialize Values\n",
        "V = {state: 0 for state in states}\n",
        "V[\"Goal\"] = 100\n",
        "\n",
        "threshold = 0.001\n",
        "\n",
        "# Value Iteration using Bellman Equation\n",
        "while True:\n",
        "    delta = 0\n",
        "\n",
        "    for state in states:\n",
        "\n",
        "        if state == \"Goal\":\n",
        "            continue\n",
        "\n",
        "        best_value = float(\"-inf\")\n",
        "\n",
        "        for action in actions[state]:\n",
        "\n",
        "            value = 0\n",
        "\n",
        "            for next_state, prob in transitions[(state, action)]:\n",
        "\n",
        "                travel_cost = cost[(state, next_state)]\n",
        "\n",
        "                reward = -travel_cost\n",
        "\n",
        "                value += prob * (reward + gamma * V[next_state])\n",
        "\n",
        "            if value > best_value:\n",
        "                best_value = value\n",
        "\n",
        "        delta = max(delta, abs(V[state] - best_value))\n",
        "        V[state] = best_value\n",
        "\n",
        "    if delta < threshold:\n",
        "        break\n",
        "\n",
        "# Find Optimal Policy\n",
        "policy = {}\n",
        "\n",
        "for state in states:\n",
        "\n",
        "    if state == \"Goal\":\n",
        "        policy[state] = \"-\"\n",
        "        continue\n",
        "\n",
        "    best_action = None\n",
        "    best_value = float(\"-inf\")\n",
        "\n",
        "    for action in actions[state]:\n",
        "\n",
        "        value = 0\n",
        "\n",
        "        for next_state, prob in transitions[(state, action)]:\n",
        "\n",
        "            reward = -cost[(state, next_state)]\n",
        "            value += prob * (reward + gamma * V[next_state])\n",
        "\n",
        "        if value > best_value:\n",
        "            best_value = value\n",
        "            best_action = action\n",
        "\n",
        "    policy[state] = best_action\n",
        "\n",
        "# Display Results\n",
        "print(\"State Values\")\n",
        "print(\"----------------\")\n",
        "\n",
        "for state in states:\n",
        "    print(state, \":\", round(V[state], 2))\n",
        "\n",
        "print(\"\\nOptimal Policy\")\n",
        "print(\"----------------\")\n",
        "\n",
        "for state in states:\n",
        "    print(state, \"->\", policy[state])\n",
        "\n",
        "print(\"\\nOptimal Path\")\n",
        "print(\"----------------\")\n",
        "\n",
        "current = \"A\"\n",
        "\n",
        "while current != \"Goal\":\n",
        "    print(current, end=\" -> \")\n",
        "\n",
        "    action = policy[current]\n",
        "\n",
        "    current = transitions[(current, action)][0][0]\n",
        "\n",
        "print(\"Goal\")"
      ]
