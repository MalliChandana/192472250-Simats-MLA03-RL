        "import numpy as np\n",
        "import random\n",
        "\n",
        "# Grid size\n",
        "size = 5\n",
        "food = (4, 4)\n",
        "ghost = (2, 2)\n",
        "\n",
        "Q = np.zeros((size, size, 4))   # 4 actions: Up, Down, Left, Right\n",
        "\n",
        "alpha = 0.1\n",
        "gamma = 0.9\n",
        "epsilon = 0.2\n",
        "\n",
        "actions = [(-1,0),(1,0),(0,-1),(0,1)]  # U,D,L,R\n",
        "\n",
        "# Training\n",
        "for episode in range(500):\n",
        "    state = (0, 0)\n",
        "\n",
        "    while state != food:\n",
        "        if random.random() < epsilon:\n",
        "            action = random.randint(0, 3)\n",
        "        else:\n",
        "            action = np.argmax(Q[state])\n",
        "\n",
        "        r, c = state\n",
        "        dr, dc = actions[action]\n",
        "\n",
        "        nr = max(0, min(size-1, r+dr))\n",
        "        nc = max(0, min(size-1, c+dc))\n",
        "        next_state = (nr, nc)\n",
        "\n",
        "        if next_state == food:\n",
        "            reward = 10\n",
        "        elif next_state == ghost:\n",
        "            reward = -10\n",
        "        else:\n",
        "            reward = -1\n",
        "\n",
        "        Q[state][action] += alpha * (\n",
        "            reward + gamma * np.max(Q[next_state]) - Q[state][action]\n",
        "        )\n",
        "\n",
        "        state = next_state\n",
        "\n",
        "# Evaluation\n",
        "state = (0, 0)\n",
        "print(\"Agent Path:\")\n",
        "while state != food:\n",
        "    print(state, end=\" -> \")\n",
        "    action = np.argmax(Q[state])\n",
        "\n",
        "    r, c = state\n",
        "    dr, dc = actions[action]\n",
        "    state = (\n",
        "        max(0, min(size-1, r+dr)),\n",
        "        max(0, min(size-1, c+dc))\n",
        "    )\n",
        "\n",
        "print(food)\n",
        "print(\"Food Reached!\")"
