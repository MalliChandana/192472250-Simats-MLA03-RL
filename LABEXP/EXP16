        "import gymnasium as gym\n",
        "!pip install stable-baselines3\n",
        "from stable_baselines3 import A2C, PPO\n",
        "\n",
        "# Create Environment\n",
        "env = gym.make(\"CartPole-v1\")\n",
        "\n",
        "# Train A2C (Actor-Critic)\n",
        "a2c = A2C(\"MlpPolicy\", env, verbose=0)\n",
        "a2c.learn(total_timesteps=10000)\n",
        "print(\"A2C Training Completed\")\n",
        "\n",
        "# Train PPO (Policy Gradient)\n",
        "ppo = PPO(\"MlpPolicy\", env, verbose=0)\n",
        "ppo.learn(total_timesteps=10000)\n",
        "print(\"PPO Training Completed\")\n",
        "\n",
        "# Compare Algorithms\n",
        "print(\"\\nComparison:\")\n",
        "print(\"A2C : Faster training, good for simple tasks\")\n",
        "print(\"PPO : More stable, better performance\")"
