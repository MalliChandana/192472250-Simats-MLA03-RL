        "import random\n",
        "\n",
        "# Hierarchical Tasks (MAXQ / HAM style)\n",
        "tasks = [\"Clean\", \"Pick\", \"Place\", \"Recharge\"]\n",
        "\n",
        "# Simulate Robot Actions\n",
        "for episode in range(5):\n",
        "    print(f\"\\nEpisode {episode+1}\")\n",
        "    reward = 0\n",
        "\n",
        "    for task in tasks:\n",
        "        action = random.choice([\"Success\", \"Retry\"])\n",
        "        print(task, \"->\", action)\n",
        "\n",
        "        if action == \"Success\":\n",
        "            reward += 10\n",
        "        else:\n",
        "            reward -= 2\n",
        "\n",
        "    print(\"Total Reward:\", reward)\n",
        "\n",
        "print(\"\\nHRL Completed using HAM/MAXQ Task Hierarchy\")"
