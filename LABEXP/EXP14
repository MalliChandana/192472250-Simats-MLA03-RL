        "import gymnasium as gym\n",
        "import tensorflow as tf\n",
        "import numpy as np\n",
        "\n",
        "env = gym.make(\"CartPole-v1\")\n",
        "\n",
        "# Actor Network\n",
        "actor = tf.keras.Sequential([\n",
        "    tf.keras.layers.Dense(24, activation=\"relu\", input_shape=(4,)),\n",
        "    tf.keras.layers.Dense(2, activation=\"softmax\")\n",
        "])\n",
        "\n",
        "# Critic Network\n",
        "critic = tf.keras.Sequential([\n",
        "    tf.keras.layers.Dense(24, activation=\"relu\", input_shape=(4,)),\n",
        "    tf.keras.layers.Dense(1)\n",
        "])\n",
        "\n",
        "actor_opt = tf.keras.optimizers.Adam(0.001)\n",
        "critic_opt = tf.keras.optimizers.Adam(0.001)\n",
        "gamma = 0.99\n",
        "\n",
        "for episode in range(100):\n",
        "    state, _ = env.reset()\n",
        "    done = False\n",
        "\n",
        "    while not done:\n",
        "        s = np.expand_dims(state, 0)\n",
        "        probs = actor(s).numpy()[0]\n",
        "        action = np.random.choice(2, p=probs)\n",
        "\n",
        "        next_state, reward, terminated, truncated, _ = env.step(action)\n",
        "        done = terminated or truncated\n",
        "\n",
        "        s2 = np.expand_dims(next_state, 0)\n",
        "        target = reward + gamma * critic(s2) * (1 - done)\n",
        "        advantage = target - critic(s)\n",
        "\n",
        "        # Update Critic\n",
        "        with tf.GradientTape() as tape:\n",
        "            loss_c = tf.square(target - critic(s))\n",
        "        grads = tape.gradient(loss_c, critic.trainable_variables)\n",
        "        critic_opt.apply_gradients(zip(grads, critic.trainable_variables))\n",
        "\n",
        "        # Update Actor\n",
        "        with tf.GradientTape() as tape:\n",
        "            p = actor(s)[0, action]\n",
        "            loss_a = -tf.math.log(p) * tf.stop_gradient(advantage)\n",
        "        grads = tape.gradient(loss_a, actor.trainable_variables)\n",
        "        actor_opt.apply_gradients(zip(grads, actor.trainable_variables))\n",
        "\n",
        "        state = next_state\n",
        "\n",
        "print(\"A2C Training Completed\")\n",
        "print(\"A3C: Similar algorithm using multiple parallel workers.\")"
      ]
