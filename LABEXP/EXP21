        "import random\n",
        "\n",
        "# States and Actions\n",
        "states = [\"Low\", \"Medium\", \"High\"]\n",
        "actions = [\"Reduce\", \"Maintain\", \"Increase\"]\n",
        "\n",
        "Q = [[0 for _ in actions] for _ in states]\n",
        "\n",
        "alpha = 0.1\n",
        "gamma = 0.9\n",
        "epsilon = 0.2\n",
        "\n",
        "# Training\n",
        "for episode in range(100):\n",
        "    state = random.randint(0, 2)\n",
        "\n",
        "    for step in range(10):\n",
        "        if random.random() < epsilon:\n",
        "            action = random.randint(0, 2)\n",
        "        else:\n",
        "            action = Q[state].index(max(Q[state]))\n",
        "\n",
        "        # Reward (lower energy = higher reward)\n",
        "        reward = 10 - abs(state - action)\n",
        "\n",
        "        next_state = random.randint(0, 2)\n",
        "\n",
        "        Q[state][action] += alpha * (\n",
        "            reward + gamma * max(Q[next_state]) - Q[state][action]\n",
        "        )\n",
        "\n",
        "        state = next_state\n",
        "\n",
        "print(\"Q-Table:\")\n",
        "for row in Q:\n",
        "    print(row)\n",
        "\n",
        "print(\"\\nSmart Energy Management Training Completed\")"
      ]
